{
  "id": "btc_4h",
  "enabled": true,
  "market": {
    "symbol": "BTCUSDT",
    "timeframe": "4h",
    "market_schedule": "24/7"
  },
  "provider": {
    "preset_path": "../providers/binance_spot.json"
  },
  "runtime": {
    "mode": "sync_live",
    "poll_interval_sec": 15.0,
    "initial_history_from": "",
    "fill_internal_gaps": true,
    "persist_to_db": true,
    "predict_on_open_candle": false
  },
  "indicators": [
    {
      "id": "ema_20",
      "type": "ema",
      "params": { "period": 20 },
      "use_in_nn": true,
      "plot": "overlay"
    },
    {
      "id": "ema_55",
      "type": "ema",
      "params": { "period": 55 },
      "use_in_nn": true,
      "plot": "overlay"
    },
    {
      "id": "sma_200",
      "type": "sma",
      "params": { "period": 200 },
      "use_in_nn": true,
      "plot": "overlay"
    },
    {
      "id": "rsi_14",
      "type": "rsi",
      "params": { "period": 14 },
      "use_in_nn": true,
      "plot": "subchart"
    },
    {
      "id": "squeeze_20",
      "type": "squeeze_momentum",
      "params": {
        "bb_length": 20,
        "bb_mult": 2.0,
        "kc_length": 20,
        "kc_mult": 1.5,
        "mom_length": 20
      },
      "use_in_nn": true,
      "plot": "subchart"
    }
  ],
  "features": {
    "input_window": 24,
    "forecast_horizon": 6,
    "stride": 1,
    "normalization": "atr_relative",
    "atr_period": 14,
    "triple_barrier": {
      "mode": "atr_multiple",
      "take_profit_atr": 1.5,
      "stop_loss_atr": 1.0
    }
  },
  "neural_networks": {
    "timeout_sec": 5.0,
    "verify_schema_on_start": true,
    "candle_predictor": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 8082,
      "schema_path": "data/btc_4h_candles_schema.json"
    },
    "signal_classifier": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 8083,
      "schema_path": "data/btc_4h_signal_schema.json"
    },
    "extra_models": {}
  },
  "analysis": {
    "min_signal_confidence": 0.55,
    "min_risk_reward": 1.5,
    "min_expected_move_pct": 0.01
  },
  "alerts": {
    "enabled": true,
    "actions": ["LONG", "SHORT"],
    "min_confidence": 0.70,
    "min_risk_reward": 1.5,
    "min_expected_move_pct": 0.01,
    "consecutive_candles": 2,
    "cooldown_candles": 4
  },
  "training": {
    "hidden_layers": [64, 32],
    "hidden_activation": "leaky_relu",
    "candle_loss": "huber",
    "huber_delta": 1.0,
    "optimizer": "adam",
    "epochs": 300,
    "batch_size": 64,
    "learning_rate": 0.001,
    "lr_schedule": "cosine",
    "min_learning_rate": 0.0001,
    "weight_decay": 0.0015,
    "dropout_rate": 0.2,
    "grad_clip_norm": 1.0,
    "validation_split": 0.2,
    "early_stopping_patience": 25,
    "early_stopping_min_delta": 0.0001,
    "num_threads": 4,
    "log_every_epochs": 10
  }
}
