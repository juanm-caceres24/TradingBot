{
  "id": "btc_1d",
  "enabled": true,
  "market": {
    "symbol": "BTCUSDT",
    "timeframe": "1d",
    "market_schedule": "24/7"
  },
  "provider": {
    "preset_path": "../providers/binance_spot.json"
  },
  "runtime": {
    "mode": "sync_live",
    "poll_interval_sec": 30.0,
    "initial_history_from": "",
    "fill_internal_gaps": true,
    "persist_to_db": true,
    "predict_on_open_candle": false
  },
  "indicators": [
    {
      "id": "sma_20",
      "type": "sma",
      "params": { "period": 20 },
      "use_in_nn": true,
      "plot": "overlay"
    },
    {
      "id": "ema_50",
      "type": "ema",
      "params": { "period": 50 },
      "use_in_nn": true,
      "plot": "overlay"
    },
    {
      "id": "rsi_14",
      "type": "rsi",
      "params": { "period": 14 },
      "use_in_nn": true,
      "plot": "subchart"
    },
    {
      "id": "atr_14",
      "type": "atr",
      "params": { "period": 14 },
      "use_in_nn": true,
      "plot": "none"
    },
    {
      "id": "squeeze_20",
      "type": "squeeze_momentum",
      "params": {
        "bb_length": 20,
        "bb_mult": 2.0,
        "kc_length": 20,
        "kc_mult": 1.5,
        "mom_length": 20
      },
      "use_in_nn": true,
      "plot": "subchart"
    }
  ],
  "features": {
    "input_window": 31,
    "forecast_horizon": 7,
    "stride": 1,
    "normalization": "atr_relative",
    "atr_period": 14,
    "triple_barrier": {
      "take_profit_pct": 0.06,
      "stop_loss_pct": 0.04
    }
  },
  "neural_networks": {
    "timeout_sec": 5.0,
    "verify_schema_on_start": true,
    "candle_predictor": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 8084,
      "schema_path": "data/btc_1d_candles_schema.json"
    },
    "signal_classifier": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 8085,
      "schema_path": "data/btc_1d_signal_schema.json"
    },
    "extra_models": {}
  },
  "analysis": {
    "min_signal_confidence": 0.55,
    "min_risk_reward": 1.5,
    "min_expected_move_pct": 0.015
  },
  "alerts": {
    "enabled": true,
    "actions": ["LONG", "SHORT"],
    "min_confidence": 0.72,
    "min_risk_reward": 1.5,
    "min_expected_move_pct": 0.015,
    "consecutive_candles": 2,
    "cooldown_candles": 3
  }
}
