{
  "id": "btc_1w",
  "enabled": true,
  "market": {
    "symbol": "BTCUSDT",
    "timeframe": "1w",
    "market_schedule": "24/7"
  },
  "provider": {
    "preset_path": "../providers/binance_spot.json"
  },
  "runtime": {
    "mode": "sync_live",
    "poll_interval_sec": 30.0,
    "initial_history_from": "",
    "fill_internal_gaps": true,
    "persist_to_db": true,
    "predict_on_open_candle": false
  },
  "indicators": [
    {
      "id": "sma_20",
      "type": "sma",
      "params": { "period": 20 },
      "use_in_nn": false,
      "plot": "overlay"
    },
    {
      "id": "ema_50",
      "type": "ema",
      "params": { "period": 50 },
      "use_in_nn": false,
      "plot": "overlay"
    },
    {
      "id": "rsi_14",
      "type": "rsi",
      "params": { "period": 14 },
      "use_in_nn": false,
      "plot": "subchart"
    }
  ],
  "features": {
    "input_window": 14,
    "forecast_horizon": 4,
    "stride": 1,
    "normalization": "atr_relative",
    "atr_period": 14,
    "triple_barrier": {
      "take_profit_pct": 0.08,
      "stop_loss_pct": 0.05
    }
  },
  "neural_networks": {
    "timeout_sec": 5.0,
    "verify_schema_on_start": true,
    "candle_predictor": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 8082,
      "schema_path": "data/btc_1w_candles_schema.json"
    },
    "signal_classifier": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 8083,
      "schema_path": "data/btc_1w_signal_schema.json"
    },
    "extra_models": {}
  },
  "analysis": {
    "min_signal_confidence": 0.60,
    "min_risk_reward": 1.5,
    "min_expected_move_pct": 0.02
  },
  "alerts": {
    "enabled": false,
    "actions": ["LONG", "SHORT"],
    "min_confidence": 0.75,
    "min_risk_reward": 1.5,
    "min_expected_move_pct": 0.02,
    "consecutive_candles": 2,
    "cooldown_candles": 4
  }
}
