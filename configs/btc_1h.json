{
  "market": {
    "symbol": "BTCUSDT",
    "timeframe": "1h",
    "market_schedule": "24/7"
  },
  "provider": {
    "preset_path": "providers/binance_spot.json"
  },
  "storage": {
    "db_path": "data/market.db",
    "wal_mode": true,
    "busy_timeout_ms": 5000
  },
  "runtime": {
    "mode": "sync_live",
    "poll_interval_sec": 5.0,
    "initial_history_from": "",
    "fill_internal_gaps": true,
    "persist_to_db": true,
    "predict_on_open_candle": false
  },
  "indicators": [
    {
      "id": "sma_20",
      "type": "sma",
      "params": { "period": 20 },
      "use_in_nn": true,
      "plot": "overlay"
    },
    {
      "id": "ema_50",
      "type": "ema",
      "params": { "period": 50 },
      "use_in_nn": true,
      "plot": "overlay"
    },
    {
      "id": "rsi_14",
      "type": "rsi",
      "params": { "period": 14 },
      "use_in_nn": true,
      "plot": "subchart"
    },
    {
      "id": "atr_14",
      "type": "atr",
      "params": { "period": 14 },
      "use_in_nn": true,
      "plot": "none"
    },
    {
      "id": "squeeze_20",
      "type": "squeeze_momentum",
      "params": {
        "bb_length": 20,
        "bb_mult": 2.0,
        "kc_length": 20,
        "kc_mult": 1.5,
        "mom_length": 20
      },
      "use_in_nn": true,
      "plot": "subchart"
    }
  ],
  "features": {
    "input_window": 31,
    "forecast_horizon": 7,
    "stride": 1,
    "normalization": "atr_relative",
    "atr_period": 14,
    "triple_barrier": {
      "take_profit_pct": 0.015,
      "stop_loss_pct": 0.01
    }
  },
  "neural_networks": {
    "timeout_sec": 5.0,
    "verify_schema_on_start": true,
    "candle_predictor": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 8080,
      "schema_path": "data/btc_1h_candles_schema.json"
    },
    "signal_classifier": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 8081,
      "schema_path": "data/btc_1h_signal_schema.json"
    }
  },
  "analysis": {
    "min_signal_confidence": 0.55,
    "min_risk_reward": 1.5,
    "min_expected_move_pct": 0.005
  },
  "web": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 8000,
    "visible_candles": 70,
    "title": "TradingBot Dashboard"
  }
}
