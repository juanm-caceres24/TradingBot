{
  "id": "demo_synthetic_1h",
  "enabled": true,
  "market": {
    "symbol": "SYNTHUSDT",
    "timeframe": "1h",
    "market_schedule": "24/7"
  },
  "provider": {
    "preset_path": "../providers/synthetic.json"
  },
  "runtime": {
    "mode": "live_only",
    "poll_interval_sec": 5.0,
    "initial_history_from": "",
    "fill_internal_gaps": false,
    "persist_to_db": true,
    "predict_on_open_candle": false
  },
  "indicators": [
    {
      "id": "ema_20",
      "type": "ema",
      "params": { "period": 20 },
      "use_in_nn": true,
      "plot": "overlay"
    },
    {
      "id": "ema_55",
      "type": "ema",
      "params": { "period": 55 },
      "use_in_nn": true,
      "plot": "overlay"
    },
    {
      "id": "sma_200",
      "type": "sma",
      "params": { "period": 200 },
      "use_in_nn": true,
      "plot": "overlay"
    },
    {
      "id": "rsi_14",
      "type": "rsi",
      "params": { "period": 14 },
      "use_in_nn": true,
      "plot": "subchart"
    },
    {
      "id": "squeeze_20",
      "type": "squeeze_momentum",
      "params": {
        "bb_length": 20,
        "bb_mult": 2.0,
        "kc_length": 20,
        "kc_mult": 1.5,
        "mom_length": 20
      },
      "use_in_nn": true,
      "plot": "subchart"
    },
    {
      "id": "vol_regime",
      "type": "volatility_regime",
      "params": {
        "fast_period": 14,
        "slow_period": 100,
        "rank_window": 100
      },
      "use_in_nn": true,
      "plot": "none"
    },
    {
      "id": "htf_4h",
      "type": "htf_context",
      "params": {
        "base_timeframe": "1h",
        "htf_timeframe": "4h",
        "ema_fast": 12,
        "ema_slow": 36,
        "rsi_period": 14
      },
      "use_in_nn": true,
      "plot": "none"
    }
  ],
  "features": {
    "input_window": 24,
    "forecast_horizon": 6,
    "stride": 1,
    "normalization": "atr_relative",
    "atr_period": 14,
    "triple_barrier": {
      "mode": "atr_multiple",
      "take_profit_atr": 1.5,
      "stop_loss_atr": 1.0
    }
  },
  "neural_networks": {
    "timeout_sec": 5.0,
    "verify_schema_on_start": true,
    "candle_predictor": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 8080,
      "schema_path": "data/demo_synthetic_1h_candles_schema.json"
    },
    "signal_classifier": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 8081,
      "schema_path": "data/demo_synthetic_1h_signal_schema.json"
    },
    "extra_models": {}
  },
  "analysis": {
    "signal_decision_mode": "directional_edge",
    "min_signal_confidence": 0.55,
    "min_directional_prob": 0.40,
    "min_directional_ratio": 1.8,
    "tp_sl_source": "triple_barrier",
    "require_candle_confirmation": false,
    "min_risk_reward": 1.5,
    "min_expected_move_pct": 0.0005
  },
  "alerts": {
    "enabled": false,
    "actions": ["LONG", "SHORT"],
    "min_confidence": 0.44,
    "min_risk_reward": 1.5,
    "min_expected_move_pct": 0.0005,
    "consecutive_candles": 2,
    "cooldown_candles": 5
  },
  "training": {
    "hidden_layers": [64, 32],
    "hidden_activation": "leaky_relu",
    "candle_loss": "huber",
    "huber_delta": 1.0,
    "optimizer": "adam",
    "epochs": 40,
    "batch_size": 64,
    "learning_rate": 0.0004,
    "lr_schedule": "cosine",
    "min_learning_rate": 0.00004,
    "weight_decay": 0.01,
    "dropout_rate": 0.2,
    "grad_clip_norm": 1.0,
    "validation_split": 0.2,
    "early_stopping_patience": 15,
    "early_stopping_min_delta": 0.0001,
    "num_threads": 4,
    "log_every_epochs": 10
  }
}
